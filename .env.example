# Padrao de credenciais do PostgreSQL (dev local)
# - Docker Compose usa o mesmo usuario/senha/banco, mas com host 'db'
# - Aplicacao FastAPI/SQLAlchemy usa driver pg8000 (postgresql+pg8000://)
DATABASE_URL=postgresql+pg8000://oficina_user:oficina_pass@localhost:5432/oficina_db

# URL para o MCP server postgres (driver padrao postgresql://, sem pg8000)
DATABASE_URL_MCP=postgresql://oficina_user:oficina_pass@localhost:5432/oficina_db

SECRET_KEY=troque-esta-chave-antes-de-usar-em-producao
ALGORITHM=HS256
TOKEN_EXPIRE_HORAS=8
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=senha123
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASSWORD=senha-de-app-gmail
EMAIL_REMETENTE=noreply@suaoficina.com
EMAIL_ADMIN=admin@suaoficina.com

# MCP Servers - tokens e configuracoes de desenvolvimento local
